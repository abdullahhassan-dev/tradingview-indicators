//@version=5
indicator("📊 Advanced CVD + Liquidity Levels", overlay=true, max_bars_back=500)

// ============================================
// ADVANCED CVD ANALYSIS
// ============================================

cvdLength = input(50, "CVD Length")
cvdSmoothing = input(20, "CVD Smoothing")

// Calculate CVD
delta = (close > open ? volume : close < open ? -volume : 0)
cvd = ta.cum(delta)
cvdSmoothed = ta.ema(cvd, cvdSmoothing)
cvdSignal = ta.ema(cvdSmoothed, 9)

// CVD Divergence
cvdDivergence = cvdSmoothed - cvdSignal
cvdHistogram = ta.ema(cvdDivergence, 5)

// ============================================
// LIQUIDITY LEVELS (Smart Money Zones)
// ============================================

lookbackPeriod = input(100, "Liquidity Lookback")
volumeThreshold = input(1.5, "Volume Threshold")

avgVol = ta.ema(volume, 20)
highVolZone = volume > avgVol * volumeThreshold

// Find recent highs and lows with high volume
recentHigh = ta.highest(high, lookbackPeriod)
recentLow = ta.lowest(low, lookbackPeriod)

// ============================================
// INSTITUTIONAL MANIPULATION DETECTION
// ============================================

// Wicks that trap retail traders
wickHigh = high - close
wickLow = close - low
bodySize = close - open

trapDetection = (wickHigh > bodySize * 2 or wickLow > bodySize * 2) and highVolZone

// ============================================
// CONFLUENCE ZONES
// ============================================

// Price at liquidity + high CVD = High probability zone
confluenceBuy = (close > recentLow and close < recentLow + ((recentHigh - recentLow) * 0.2)) and cvdHistogram > 0 and highVolZone

confluenceSell = (close < recentHigh and close > recentHigh - ((recentHigh - recentLow) * 0.2)) and cvdHistogram < 0 and highVolZone

// ============================================
// VOLUME STRENGTH INDICATOR
// ============================================

volumeStrength = (volume - ta.lowest(volume, 20)) / (ta.highest(volume, 20) - ta.lowest(volume, 20))
strongVolume = volumeStrength > 0.7

// ============================================
// PLOTTING
// ============================================

// Plot liquidity levels
plot(recentHigh, color=color.new(color.red, 50), linewidth=2, title="Resistance Liquidity")
plot(recentLow, color=color.new(color.green, 50), linewidth=2, title="Support Liquidity")

// CVD Histogram
plotshape(cvdHistogram > 0 ? cvdHistogram : na, style=shape.bars, location=location.bottom, color=color.new(color.green, 60), title="CVD Bullish")
plotshape(cvdHistogram < 0 ? cvdHistogram : na, style=shape.bars, location=location.bottom, color=color.new(color.red, 60), title="CVD Bearish")

// Confluence signals
plotshape(confluenceBuy and strongVolume, style=shape.labelup, location=location.belowbar, color=color.new(color.green, 0), size=size.large, text="🎯 CONFLUENCE BUY")

plotshape(confluenceSell and strongVolume, style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), size=size.large, text="🎯 CONFLUENCE SELL")

// Trap detection warning
plotshape(trapDetection, style=shape.diamond, location=location.abovebar, color=color.new(color.orange, 50), size=size.small, title="Trap Warning")

// High volume zones background
bgcolor(highVolZone ? color.new(color.yellow, 90) : na, title="High Volume Zone")

// ============================================
// ALERTS
// ============================================

if confluenceBuy and strongVolume
    alert("🎯 HIGH PROBABILITY BUY - Confluence + Strong Volume", alert.freq_once_per_bar)

if confluenceSell and strongVolume
    alert("⚠️ HIGH PROBABILITY SELL - Confluence + Strong Volume", alert.freq_once_per_bar)

if trapDetection
    alert("⚡ TRAP DETECTED - Be careful, retail traders are being trapped!", alert.freq_once_per_bar)
